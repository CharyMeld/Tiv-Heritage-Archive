a:2:{s:5:"value";a:8:{s:13:"featuredNames";a:10:{i:0;a:17:{s:2:"id";i:256;s:8:"tiv_name";s:8:"Ityowase";s:15:"english_meaning";s:37:"Helped / assisted by paternal kinsmen";s:6:"gender";s:6:"unisex";s:11:"description";s:47:"Cultural Beliefs: Maternal and Paternal Kinsmen";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:11:"Ityo + wase";s:13:"usage_context";s:56:"Honours the father's lineage; Ityo = paternal kin group.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:2;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:52:02";s:9:"source_id";N;}i:1;a:17:{s:2:"id";i:257;s:8:"tiv_name";s:8:"Ityoyima";s:15:"english_meaning";s:37:"Saved / delivered by paternal kinsmen";s:6:"gender";s:6:"unisex";s:11:"description";s:47:"Cultural Beliefs: Maternal and Paternal Kinsmen";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:11:"Ityo + yima";s:13:"usage_context";s:29:"Honours the father's lineage.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:2;a:17:{s:2:"id";i:258;s:8:"tiv_name";s:9:"Ityohemba";s:15:"english_meaning";s:49:"None is as powerful / helpful as paternal kinsmen";s:6:"gender";s:6:"unisex";s:11:"description";s:47:"Cultural Beliefs: Maternal and Paternal Kinsmen";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:12:"Ityo + hemba";s:13:"usage_context";s:50:"Celebrates the supreme importance of paternal kin.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:3;a:17:{s:2:"id";i:259;s:8:"tiv_name";s:9:"Aondowase";s:15:"english_meaning";s:24:"Helped / assisted by God";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:13:"Aôndo + wase";s:13:"usage_context";s:60:"Aôndo is the Tiv name for God; expresses divine assistance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:4;a:17:{s:2:"id";i:260;s:8:"tiv_name";s:9:"Aondoyima";s:15:"english_meaning";s:24:"Saved / delivered by God";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:13:"Aôndo + yima";s:13:"usage_context";s:29:"Expresses divine deliverance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:5;a:17:{s:2:"id";i:261;s:8:"tiv_name";s:10:"Aondohemba";s:15:"english_meaning";s:36:"None is as powerful / helpful as God";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:14:"Aôndo + hemba";s:13:"usage_context";s:48:"God wins / God is supreme; compound divine name.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:6;a:17:{s:2:"id";i:262;s:8:"tiv_name";s:7:"Teryima";s:15:"english_meaning";s:35:"Saved / delivered by God the Father";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:10:"Ter + yima";s:13:"usage_context";s:47:"Expresses divine deliverance by God the Father.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:7;a:17:{s:2:"id";i:263;s:8:"tiv_name";s:8:"Terhemba";s:15:"english_meaning";s:47:"None is as powerful / helpful as God the Father";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:11:"Ter + hemba";s:13:"usage_context";s:33:"God the Father wins / is supreme.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:8;a:17:{s:2:"id";i:264;s:8:"tiv_name";s:7:"Torwase";s:15:"english_meaning";s:42:"Helped / assisted by God the King of kings";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:10:"Tor + wase";s:13:"usage_context";s:49:"Tor = King of kings; expresses divine assistance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:9;a:17:{s:2:"id";i:265;s:8:"tiv_name";s:7:"Toryima";s:15:"english_meaning";s:42:"Saved / delivered by God the King of kings";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:10:"Tor + yima";s:13:"usage_context";s:29:"Expresses divine deliverance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}}s:16:"featuredProverbs";a:10:{i:0;a:12:{s:2:"id";i:192;s:8:"tiv_text";s:37:"Ka we a yesen Anyam wan uye atuul ga.";s:19:"english_translation";s:47:"When nursing a lion's cub, you do not eat okra.";s:14:"deeper_meaning";s:260:"Injakwagh ne tese mdoom ma dondo. Shin u dondon vea or u na lu a kwagh ave yô. Anyam ka inyamkyume i eren ikyōr kpishi, tese er a lu or nana lu yesen Anyam wan yên nan a yaan inyam hanma shie. Tese er a lu u ngu ijende vea ornyar yó inyaregh ki a ban u ga.";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:1;a:12:{s:2:"id";i:193;s:8:"tiv_text";s:80:"Kwase u fankwagh ka un a tema tswen kpa a wa ikyondo anam, saa nomso ve a lu ga.";s:19:"english_translation";s:84:"A wise woman covers her thighs even when she is alone, not only when men are around.";s:14:"deeper_meaning";s:264:"Tiv mba ôron injakwagh ne u tesen iyol-kôron-tsaha. Tese er or a vande sõron ya u nan cii ve vanya un a va ye. Ka u tesen er, we u vande karen iyol sha hanma kwagh cii ve u gba ami tembe ye. Ka u vanden lun a ago a wan iyol sha er kwagh un a bur u a bur ga yô.";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:2;a:12:{s:2:"id";i:194;s:8:"tiv_text";s:86:"Ka a jiidi mngerem aciin ape wan a dugh yô, аре akôngo a dugh la kpa ma za bende.";s:19:"english_translation";s:102:"When they press a woman in labour, the hot water reaches the place where the stool comes from as well.";s:14:"deeper_meaning";s:232:"Ngun ka u kaan er ka we a ya ikyar vea or nana zua a kwagh we kpa kwagh a ban u ga. Ka a er a or dedoo wea lu ikyua we kpaa erdoo la a bende a we. Ka injakwagh ne imiôm Tiv ka ve kaa er "mba a kar a ku hen we, u haa mlyam ashe ye".";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:3;a:12:{s:2:"id";i:195;s:8:"tiv_text";s:46:"Nor ngu ken toho kpa a yange mbahyev zende ga.";s:19:"english_translation";s:76:"The elephant may be in the bush, yet it does not stop the rats from roaming.";s:14:"deeper_meaning";s:147:"Tiv mba er injakwagh ne u pasen er mlu wou a de yinan we ga. Tese er or nan a lu a inyaregh kpishi, we a lu ami a kuma ga kpa, ishima i de yen u ga";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:4;a:12:{s:2:"id";i:196;s:8:"tiv_text";s:263:"Ka we a dughun iginogyo u kera kor llyó ga. Mba hembe dron injakwagh ne u tesen ghashim sha hanma kwagh u usoo u eren yo. Tese er ka w a na ishima u eren kwagh yo u kera zungu lyo vihin shin kunya ga. Shin ityuhwanev kpa u kone ongo ga shin anger man ilyahan ga.";s:19:"english_translation";s:68:"When performing acrobatics, you no longer worry about your buttocks.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:5;a:12:{s:2:"id";i:197;s:8:"tiv_text";s:128:"Organden u nan ver ishima er nan a va bee iyol nan a tema ken mule yo, nan gberen a gber ikyon ga, ka nan môör a möör ikyon.";s:19:"english_translation";s:108:"An elder who hopes to rest under the shade of a tree in his old age does not cut down trees; he plants them.";s:14:"deeper_meaning";s:277:"Tiv mba er injakwagh ne u tesen vor u dedoo u veren hen ityo you. Ka u pasen er, doo u eren aeren a dedoo sha er a va zaan a we ityo yo. Inja i dedoo kai lu sha awe tseegh ga zan zan sha mbayev ou kpaa. Or a de kera hiin a hii iyongo ga kpa nan a eren a er akaa a nan mzehemen.";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:6;a:12:{s:2:"id";i:198;s:8:"tiv_text";s:67:"Wanivongo u amende akor a yem sha Aonde war war yongu a mon u toon.";s:19:"english_translation";s:76:"A sheep with long horns must surely have a neck strong enough to carry them.";s:14:"deeper_meaning";s:128:"Tiv mba hembe aron gba hiin kwagh ga saa u vande wan iyol Shi doo er u vande fan myohom ma hanma kwagh cii u hii tom sha mi yô.";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:7;a:12:{s:2:"id";i:199;s:8:"tiv_text";s:50:"U ngu a ayem angahar je u ker Agômik ya ivaan ye.";s:19:"english_translation";s:80:"Only the man who trusts the speed of his legs shoots an arrow at a patas monkey.";s:14:"deeper_meaning";s:296:"Tiv mba er injakwagh ne u pasen agee shin tahav mbu wan iyol cii hiin kwagh ye. Agômikya ka Ikya i gban ikyōr shi vihin tu. U or keren un ivaan yô u vande fan wer ka keng u ta un yô un a zenda u, nahan ka u fan wer u ngu a ayem a yevese. Doo u vanden peven iyol you nengen cii u hii kwagh ye.";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:8;a:12:{s:2:"id";i:200;s:8:"tiv_text";s:48:"Ivyekpekpe lan amar ga, ka er nomkwegh atil yô.";s:19:"english_translation";s:84:"A cockroach is not a poor dancer; it simply cannot dances in the presence of a cock.";s:14:"deeper_meaning";s:201:"Tiv mba er injakwagh ne u pasen myina u agee. Ka u tesen er shie gen ka u fa u eren a or dedoo kpa u kera lu a inyaregh ga. Shin ka or fa er nan a kaha sule ua wase tsombor u nan kpa nan lu a akôr ga.";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}i:9;a:12:{s:2:"id";i:201;s:8:"tiv_text";s:53:"Ka we a ya ikyar a bagu ivaan ngi saan we sha kon ga.";s:19:"english_translation";s:74:"When you make friends with a monkey, you do not lose your arrow in a tree.";s:14:"deeper_meaning";s:235:"Tiv mba hembe õron injakwagh ne u tesen myima u boki shin ikyar. Ka u tesen mtsera u dedoo sha ndorwan. Ka we a dondo vea ortwer yô, kwagh nyion hembe u u sôron ga. Shi tese er ka we a dondo vea ornyar, kpandegh ku hembe u u tan ga.";s:13:"usage_context";N;s:8:"category";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-07-27 17:39:03";s:10:"updated_at";s:19:"2026-07-27 17:39:03";s:9:"source_id";i:157;}}s:14:"featuredPlants";a:10:{i:0;a:17:{s:2:"id";i:366;s:8:"tiv_name";s:5:"Tovor";s:12:"english_name";s:34:"Southern dodder; Australian dodder";s:15:"scientific_name";s:17:"Cuscuta australis";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:1;a:17:{s:2:"id";i:367;s:8:"tiv_name";s:19:"Tsabagu; Tsa-avange";s:12:"english_name";s:32:"Windmill grass; Newton's ctenium";s:15:"scientific_name";s:16:"Ctenium newtonii";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:2;a:17:{s:2:"id";i:368;s:8:"tiv_name";s:20:"Tsakombo; Ngaji; Awa";s:12:"english_name";s:43:"African rosewood; Barwood; Senegal rosewood";s:15:"scientific_name";s:21:"Pterocarpus erinaceus";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:3;a:17:{s:2:"id";i:369;s:8:"tiv_name";s:8:"Tyembegh";s:12:"english_name";s:34:"Sausage tree; African sausage tree";s:15:"scientific_name";s:16:"Kigelia africana";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:4;a:17:{s:2:"id";i:370;s:8:"tiv_name";s:6:"Tyombu";s:12:"english_name";s:23:"Psychotria; Wild coffee";s:15:"scientific_name";s:16:"Psychotria calva";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:5;a:17:{s:2:"id";i:371;s:8:"tiv_name";s:9:"Uer, Uwer";s:12:"english_name";s:38:"Resurrection lily; West African ginger";s:15:"scientific_name";s:23:"Siphonochilus nigericus";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:6;a:17:{s:2:"id";i:372;s:8:"tiv_name";s:21:"Umanatumba; Kpantembe";s:12:"english_name";s:42:"Karaya gum tree; Tropical sterculia; Mbuyu";s:15:"scientific_name";s:18:"Sterculia setigera";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:7;a:17:{s:2:"id";i:373;s:8:"tiv_name";s:4:"Usaa";s:12:"english_name";s:37:"Indian jujube; Ber tree; Chinese date";s:15:"scientific_name";s:19:"Ziziphus mauritiana";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:8;a:17:{s:2:"id";i:374;s:8:"tiv_name";s:4:"Uwua";s:12:"english_name";s:46:"Palisade signal grass; Brachiaria; Congo grass";s:15:"scientific_name";s:20:"Brachiaria brizantha";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}i:9;a:17:{s:2:"id";i:375;s:8:"tiv_name";s:28:"Wannune-chi; Anmune-chi ark.";s:12:"english_name";s:38:"Partridge pea; Sensitive partridge pea";s:15:"scientific_name";s:24:"Chamaechrista mimoscides";s:11:"description";N;s:14:"medicinal_uses";N;s:9:"food_uses";N;s:11:"ritual_uses";N;s:11:"cultivation";N;s:5:"image";N;s:10:"audio_file";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-06-05 15:34:40";s:10:"updated_at";s:19:"2026-06-05 15:34:40";s:9:"source_id";N;}}s:17:"featuredFestivals";a:8:{i:0;a:18:{s:2:"id";i:3;s:8:"tiv_name";s:14:"Kyegh Sha Shwa";s:12:"english_name";s:32:"Kyegh Sha Shwa Cultural Festival";s:13:"festival_type";s:26:"Food and Cultural Festival";s:11:"description";s:288:"An annual large-scale Tiv cultural gathering held in Makurdi. It celebrates Tiv heritage through traditional food, music, and dance. The festival is especially associated with Nyamkyegh sha shwa, a traditional chicken and beniseed dish that holds deep cultural meaning for the Tiv people.";s:12:"significance";s:326:"This festival serves as a living expression of Tiv culinary heritage and communal identity. It brings together Tiv people across generations to share, perform, and transmit their food traditions, dances, and music. The Nyamkyegh sha shwa dish is central to the gathering, symbolising Tiv domesticity and agricultural heritage.";s:6:"timing";s:8:"December";s:8:"duration";N;s:10:"activities";s:134:"Traditional Tiv food preparation and sharing, cultural dances, music performances, community gathering, display of traditional attire.";s:8:"location";s:20:"Makurdi, Benue State";s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:2;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 14:17:03";s:9:"source_id";N;s:13:"gallery_image";N;}i:1;a:18:{s:2:"id";i:4;s:8:"tiv_name";s:9:"Kwagh-Hir";s:12:"english_name";s:25:"Kwagh-Hir Puppet Festival";s:13:"festival_type";s:31:"Dramatic / Performance Festival";s:11:"description";s:330:"A renowned Tiv dramatic folk theatre tradition that uses puppets, marionettes, masquerades, music, and storytelling. It presents themes of social conflict, history, morality, and community ethics through highly creative performance. Kwagh-Hir is regarded as one of Africa's most sophisticated indigenous puppet theatre traditions.";s:12:"significance";s:314:"Kwagh-Hir is not merely entertainment — it is a powerful instrument of social commentary and moral education among the Tiv. Through symbolic puppetry and drama, communities critique injustice, retell history, and affirm shared values. It is a form of living cultural philosophy performed for the whole community.";s:6:"timing";s:18:"December – April";s:8:"duration";N;s:10:"activities";s:138:"Puppetry performances, marionette displays, masquerades, storytelling, live music, dramatic re-enactments of social and historical themes.";s:8:"location";s:42:"Tiv communities, especially in Benue State";s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:2;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-08-01 10:46:16";s:9:"source_id";N;s:13:"gallery_image";N;}i:2;a:18:{s:2:"id";i:5;s:8:"tiv_name";s:7:"Tiv Day";s:12:"english_name";s:19:"Tiv Day Celebration";s:13:"festival_type";s:36:"Cultural Unity and Identity Festival";s:11:"description";s:320:"A major annual celebration that brings Tiv people together across Nigeria and the diaspora to celebrate their shared identity, culture, and heritage. It commonly features traditional attire, dance, storytelling, and cultural discussions. Tiv Day is a unifying moment of pride and cultural affirmation for the Tiv nation.";s:12:"significance";s:275:"Tiv Day represents a conscious effort by the Tiv people to preserve and celebrate their cultural identity in the face of modernisation. It reaffirms the values of the A'nger fabric, the Swange dance, and communal storytelling as living symbols of Tiv resilience and cohesion.";s:6:"timing";s:6:"Annual";s:8:"duration";N;s:10:"activities";s:159:"A'nger traditional attire display, Swange dance performances, storytelling sessions, cultural lectures and panel discussions, community reunion and networking.";s:8:"location";s:38:"Gboko and major cities including Lagos";s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:3;a:18:{s:2:"id";i:6;s:8:"tiv_name";s:4:"Ivom";s:12:"english_name";s:19:"Ivom Dance Festival";s:13:"festival_type";s:35:"Dance and Cultural Renewal Festival";s:11:"description";s:290:"A traditional Tiv festival centred on the Ivom dance. It promotes cultural renewal, celebration, and the preservation of Tiv dance aesthetics and performance traditions. The Ivom festival is a gathering of communities around the shared love of Tiv movement, rhythm, and artistic expression.";s:12:"significance";s:230:"The Ivom Dance Festival is a vehicle for passing down traditional Tiv dance forms to younger generations. It reinforces the cultural importance of rhythm, communal performance, and artistic identity as foundations of Tiv heritage.";s:6:"timing";s:50:"Not specifically fixed; held as communities decide";s:8:"duration";N;s:10:"activities";s:131:"Ivom dance performances, cultural exhibitions, musical accompaniment, celebration of dance heritage, renewal of communal tradition.";s:8:"location";s:15:"Tiv communities";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:1;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-07-23 20:04:28";s:9:"source_id";N;s:13:"gallery_image";N;}i:4;a:18:{s:2:"id";i:7;s:8:"tiv_name";s:5:"Akata";s:12:"english_name";s:22:"Akata Fishing Festival";s:13:"festival_type";s:29:"Fishing and Communal Festival";s:11:"description";s:363:"A traditional fishing festival held in Katsina-Ala that showcases local fishing skills and techniques. It attracts participants and competitors from Tiv, Etulo, and Jukun communities, making it one of the most inter-ethnic cultural events along the Katsina-Ala River. It celebrates the riverine heritage and livelihood of the communities that depend on the river.";s:12:"significance";s:298:"The Akata Fishing Festival affirms the deep relationship between the Tiv and neighbouring communities and the rivers that sustain them. It celebrates indigenous ecological knowledge, inter-community cooperation, and the cultural significance of fishing as a way of life along the Katsina-Ala River.";s:6:"timing";s:13:"March – May";s:8:"duration";N;s:10:"activities";s:214:"Fishing competitions using traditional methods, demonstration of indigenous fishing techniques, inter-community participation from Tiv, Etulo and Jukun, cultural performances and celebration of riverine livelihood.";s:8:"location";s:11:"Katsina-Ala";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:5;a:18:{s:2:"id";i:8;s:8:"tiv_name";s:19:"Biem and Toho Yilan";s:12:"english_name";s:36:"Biem and Toho Yilan Hunting Festival";s:13:"festival_type";s:16:"Hunting Festival";s:11:"description";s:328:"A traditional Tiv hunting festival involving both inter-clan hunting expeditions (Biem) and intra-clan hunting expeditions (Toho Yilan). These expeditions are usually accompanied by cultural dances and communal celebration. The festival reflects the historical importance of hunting in Tiv social organisation and clan identity.";s:12:"significance";s:274:"The Biem and Toho Yilan festival reinforces Tiv clan solidarity and the tradition of collective endeavour. Hunting is not merely a subsistence activity but a ritual that binds clans together, tests endurance, and reaffirms the covenant between the Tiv people and their land.";s:6:"timing";s:18:"December – April";s:8:"duration";N;s:10:"activities";s:154:"Inter-clan hunting expeditions (Biem), intra-clan hunting expeditions (Toho Yilan), cultural dances following the hunt, communal feasting and celebration.";s:8:"location";s:15:"Tiv communities";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:6;a:18:{s:2:"id";i:9;s:8:"tiv_name";s:6:"Nyinya";s:12:"english_name";s:15:"Nyinya Festival";s:13:"festival_type";s:34:"Wealth / Social Status Celebration";s:11:"description";s:330:"A traditional celebration of affluence in which a person who acquires a horse — a powerful symbol of wealth and prestige among the Tiv — hosts a feast for their age group. The event is marked by praise songs, feasting, and traditional dance performances. The horse (nyinya) is one of the highest status symbols in Tiv culture.";s:12:"significance";s:317:"The Nyinya Festival reflects the Tiv value system in which personal achievement is celebrated communally. Wealth is not hoarded but shared with one's age group, reinforcing bonds of solidarity and reciprocity. The horse as a status symbol also connects to Tiv concepts of strength, war readiness, and spiritual power.";s:6:"timing";s:53:"Not specifically fixed; held when a horse is acquired";s:8:"duration";N;s:10:"activities";s:166:"Communal feast hosted by the horse owner, praise songs (ikyagh) performed by traditional singers, traditional dance performances, age-group gathering and celebration.";s:8:"location";s:15:"Tiv communities";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:7;a:18:{s:2:"id";i:2;s:8:"tiv_name";s:22:"Iniongo i iyou mbi her";s:12:"english_name";s:16:"New Yam Festival";s:13:"festival_type";N;s:11:"description";s:71:"Annual harvest celebration marking the beginning of the new yam season.";s:12:"significance";s:73:"Thanksgiving for successful harvest and prayers for continued prosperity.";s:6:"timing";s:38:"August/September after the yam harvest";s:8:"duration";N;s:10:"activities";s:65:"Traditional dances, feasting, offering of first yams to ancestors";s:8:"location";N;s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:3;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-16 19:13:12";s:10:"updated_at";s:19:"2026-03-19 16:12:56";s:9:"source_id";N;s:13:"gallery_image";N;}}s:13:"featuredFoods";a:2:{i:0;a:15:{s:2:"id";i:1;s:8:"tiv_name";s:10:"Ruam Kumen";s:12:"english_name";s:11:"Pounded Yam";s:11:"description";s:75:"A staple food made from boiled and pounded yams, served with various soups.";s:11:"ingredients";s:17:"Fresh yams, water";s:18:"preparation_method";s:87:"Yams are peeled, boiled until soft, then pounded in a mortar until smooth and stretchy.";s:19:"serving_suggestions";N;s:21:"cultural_significance";N;s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:4;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-16 19:13:12";s:10:"updated_at";s:19:"2026-03-19 15:02:32";s:9:"source_id";N;}i:1;a:15:{s:2:"id";i:2;s:8:"tiv_name";s:6:"Gbande";s:12:"english_name";s:8:"Tiv Soup";s:11:"description";s:61:"A traditional Tiv soup made with local vegetables and spices.";s:11:"ingredients";s:63:"Bitter leaf, locust beans, palm oil, meat or fish, local spices";s:18:"preparation_method";s:84:"Vegetables are washed and cooked with meat stock, palm oil and seasonings are added.";s:19:"serving_suggestions";N;s:21:"cultural_significance";N;s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:3;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-16 19:13:12";s:10:"updated_at";s:19:"2026-03-20 14:05:55";s:9:"source_id";N;}}s:15:"featuredAnimals";a:10:{i:0;a:14:{s:2:"id";i:11;s:8:"tiv_name";s:5:"Anyam";s:4:"name";s:7:"Leopard";s:11:"description";s:99:"Wild predator; one of the most spiritually significant animals in Tiv culture. Also known as Anyam.";s:12:"cultural_use";s:96:"Used in Igbe religious rites for anti-witchcraft protection; priests invoke the leopard's power.";s:16:"symbolic_meaning";s:96:"Power, ancestral aggression, spiritual authority, and anti-witchcraft force; used in Igbe rites.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:1;a:14:{s:2:"id";i:12;s:8:"tiv_name";s:4:"Bagu";s:4:"name";s:6:"Monkey";s:11:"description";s:87:"Wild primate associated with mystical transformation in Tiv belief. Also known as Bagu.";s:12:"cultural_use";s:68:"Used in rituals of spiritual embodiment and mystical transformation.";s:16:"symbolic_meaning";s:85:"Linked to mystical transformation, spiritual embodiment, and external soul symbolism.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:2;a:14:{s:2:"id";i:13;s:8:"tiv_name";s:3:"Bua";s:4:"name";s:20:"Tiv native cow / Cow";s:11:"description";s:93:"Domestic cattle; foundational animal in Tiv social and ritual economy. Also called Bua-u-Tiv.";s:12:"cultural_use";s:92:"Used in bride price, sacred property transactions, and ritual observances requiring caution.";s:16:"symbolic_meaning";s:88:"Associated with human life, sacred property, ritual caution, and spiritual consequences.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:8:"domestic";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:3;a:14:{s:2:"id";i:14;s:8:"tiv_name";s:6:"Nyinya";s:4:"name";s:5:"Horse";s:11:"description";s:88:"Domestic animal associated with power, warfare, and mystical transport in Tiv tradition.";s:12:"cultural_use";s:82:"Used symbolically in war defence and as a marker of status and spiritual mobility.";s:16:"symbolic_meaning";s:68:"Symbol of strength, speed, war defence, and mystical transportation.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:8:"domestic";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:4;a:14:{s:2:"id";i:15;s:8:"tiv_name";s:4:"Iywa";s:4:"name";s:3:"Dog";s:11:"description";s:92:"Domestic/pet animal with exceptional spiritual perception in Tiv belief. Also rendered Iwya.";s:12:"cultural_use";s:93:"Kept as a domestic guardian; its behaviour is read as an omen or warning of spiritual danger.";s:16:"symbolic_meaning";s:91:"Believed to see both physical and metaphysical realities; detects spirits, evil, and omens.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:3:"pet";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:5;a:14:{s:2:"id";i:16;s:8:"tiv_name";s:3:"Apu";s:4:"name";s:7:"Vulture";s:11:"description";s:69:"Wild scavenging bird with deep mystical associations in Tiv religion.";s:12:"cultural_use";s:73:"Associated with witchcraft communication; appears in divination contexts.";s:16:"symbolic_meaning";s:79:"Mystical bird associated with spiritual communication and witchcraft symbolism.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:6;a:14:{s:2:"id";i:17;s:8:"tiv_name";s:6:"Avungu";s:4:"name";s:3:"Owl";s:11:"description";s:98:"Wild nocturnal bird; primary Tiv symbol of the ancestors and the unseen world. Also called Ivungu.";s:12:"cultural_use";s:89:"Central to ancestral communication rites; its call is interpreted as a spiritual message.";s:16:"symbolic_meaning";s:82:"Strong symbol of ancestors, unseen world, witchcraft, and spiritual communication.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:7;a:14:{s:2:"id";i:18;s:8:"tiv_name";s:4:"Gbev";s:4:"name";s:24:"Standard-winged nightjar";s:11:"description";s:78:"Wild nocturnal bird linked to spiritual movement and witchcraft in Tiv belief.";s:12:"cultural_use";s:68:"Associated with nocturnal spirit activity and witchcraft ceremonies.";s:16:"symbolic_meaning";s:78:"Nocturnal mystical bird linked to spirits, witchcraft, and spiritual movement.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:8;a:14:{s:2:"id";i:19;s:8:"tiv_name";s:6:"Swande";s:4:"name";s:13:"Violet turaco";s:11:"description";s:83:"Wild bird associated with spiritual sight and ritual transformation in Tiv culture.";s:12:"cultural_use";s:73:"Used in ritual transformation ceremonies and spiritual journey symbolism.";s:16:"symbolic_meaning";s:69:"Associated with sight, spiritual journeys, and ritual transformation.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:9;a:14:{s:2:"id";i:20;s:8:"tiv_name";s:5:"Akiki";s:4:"name";s:17:"Pearl-spotted owl";s:11:"description";s:74:"Wild owl species with ancestral and mystical significance in Tiv religion.";s:12:"cultural_use";s:40:"Used in ancestral communication rituals.";s:16:"symbolic_meaning";s:74:"Owl species associated with ancestral presence and mystical communication.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}}s:14:"learningVideos";a:0:{}s:21:"festivalGalleryPhotos";a:0:{}}s:7:"expires";i:1785613889;}