a:2:{s:5:"value";a:8:{s:13:"featuredNames";a:10:{i:0;a:17:{s:2:"id";i:256;s:8:"tiv_name";s:8:"Ityowase";s:15:"english_meaning";s:37:"Helped / assisted by paternal kinsmen";s:6:"gender";s:6:"unisex";s:11:"description";s:47:"Cultural Beliefs: Maternal and Paternal Kinsmen";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:11:"Ityo + wase";s:13:"usage_context";s:56:"Honours the father's lineage; Ityo = paternal kin group.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:2;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:52:02";s:9:"source_id";N;}i:1;a:17:{s:2:"id";i:257;s:8:"tiv_name";s:8:"Ityoyima";s:15:"english_meaning";s:37:"Saved / delivered by paternal kinsmen";s:6:"gender";s:6:"unisex";s:11:"description";s:47:"Cultural Beliefs: Maternal and Paternal Kinsmen";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:11:"Ityo + yima";s:13:"usage_context";s:29:"Honours the father's lineage.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:2;a:17:{s:2:"id";i:258;s:8:"tiv_name";s:9:"Ityohemba";s:15:"english_meaning";s:49:"None is as powerful / helpful as paternal kinsmen";s:6:"gender";s:6:"unisex";s:11:"description";s:47:"Cultural Beliefs: Maternal and Paternal Kinsmen";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:12:"Ityo + hemba";s:13:"usage_context";s:50:"Celebrates the supreme importance of paternal kin.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:3;a:17:{s:2:"id";i:259;s:8:"tiv_name";s:9:"Aondowase";s:15:"english_meaning";s:24:"Helped / assisted by God";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:13:"Aôndo + wase";s:13:"usage_context";s:60:"Aôndo is the Tiv name for God; expresses divine assistance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:4;a:17:{s:2:"id";i:260;s:8:"tiv_name";s:9:"Aondoyima";s:15:"english_meaning";s:24:"Saved / delivered by God";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:13:"Aôndo + yima";s:13:"usage_context";s:29:"Expresses divine deliverance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:5;a:17:{s:2:"id";i:261;s:8:"tiv_name";s:10:"Aondohemba";s:15:"english_meaning";s:36:"None is as powerful / helpful as God";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:14:"Aôndo + hemba";s:13:"usage_context";s:48:"God wins / God is supreme; compound divine name.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:6;a:17:{s:2:"id";i:262;s:8:"tiv_name";s:7:"Teryima";s:15:"english_meaning";s:35:"Saved / delivered by God the Father";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:10:"Ter + yima";s:13:"usage_context";s:47:"Expresses divine deliverance by God the Father.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:7;a:17:{s:2:"id";i:263;s:8:"tiv_name";s:8:"Terhemba";s:15:"english_meaning";s:47:"None is as powerful / helpful as God the Father";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:11:"Ter + hemba";s:13:"usage_context";s:33:"God the Father wins / is supreme.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:8;a:17:{s:2:"id";i:264;s:8:"tiv_name";s:7:"Torwase";s:15:"english_meaning";s:42:"Helped / assisted by God the King of kings";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:10:"Tor + wase";s:13:"usage_context";s:49:"Tor = King of kings; expresses divine assistance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}i:9;a:17:{s:2:"id";i:265;s:8:"tiv_name";s:7:"Toryima";s:15:"english_meaning";s:42:"Saved / delivered by God the King of kings";s:6:"gender";s:6:"unisex";s:11:"description";s:36:"Divine Names: Aôndo, Ter, Tor, Usha";s:13:"pronunciation";N;s:10:"audio_file";N;s:13:"related_names";N;s:12:"origin_story";s:10:"Tor + yima";s:13:"usage_context";s:29:"Expresses divine deliverance.";s:6:"source";s:223:"Udu, T.T. (2019). Names as Repositories of Worldview: Empirical Evidence from the Morphological and Semantic Analysis of Tiv Personal Names. International Journal of Language and Linguistics, 6(4). doi:10.30845/ijll.v6n4p12";s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:16:57";s:10:"updated_at";s:19:"2026-03-20 13:16:57";s:9:"source_id";N;}}s:16:"featuredProverbs";a:10:{i:0;a:12:{s:2:"id";i:78;s:8:"tiv_text";s:21:"Tegh tegh hemba ayem.";s:19:"english_translation";s:56:"It’s better to take time to do something than to rush.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:1;a:12:{s:2:"id";i:79;s:8:"tiv_text";s:25:"Kokombo per sha jime nor.";s:19:"english_translation";s:60:"You tag uno someone to get out of trouble or bad situations.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:2;a:12:{s:2:"id";i:80;s:8:"tiv_text";s:18:"Mnenge hemba mtem.";s:19:"english_translation";s:41:"It’s better to try than to remain idle.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:3;a:12:{s:2:"id";i:81;s:8:"tiv_text";s:32:"Tokwa u purugh hembe u nahan ga.";s:19:"english_translation";s:32:"You may lose some but gain more.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:4;a:12:{s:2:"id";i:82;s:8:"tiv_text";s:28:"Ka wea gba mnger u mor iyav.";s:19:"english_translation";s:69:"One is into something and there is no going back—encouraging words.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:5;a:12:{s:2:"id";i:83;s:8:"tiv_text";s:23:"Wua u wanye kpa nor ye.";s:19:"english_translation";s:73:"Listening to a child can help adults. Children have useful opinions, too.";s:14:"deeper_meaning";s:46:"An elephant even eats a child’s guinea corn.";s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:6;a:12:{s:2:"id";i:84;s:8:"tiv_text";s:72:"Ahi nga hie orapirashe atsenge ahar ga. Similar: once beaten, twice shy.";s:19:"english_translation";s:36:"Don’t make the same mistake twice.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:7;a:12:{s:2:"id";i:85;s:8:"tiv_text";s:16:"Yan sha ikughul.";s:19:"english_translation";s:24:"Very close relationship.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:8;a:12:{s:2:"id";i:86;s:8:"tiv_text";s:11:"Nur akende.";s:19:"english_translation";s:14:"Display pride.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}i:9;a:12:{s:2:"id";i:87;s:8:"tiv_text";s:11:"Nur igundu.";s:19:"english_translation";s:15:"Act with pride.";s:14:"deeper_meaning";N;s:13:"usage_context";N;s:8:"category";s:5:"idiom";s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";N;s:10:"created_at";s:19:"2026-03-23 22:48:18";s:10:"updated_at";s:19:"2026-03-23 22:48:18";s:9:"source_id";N;}}s:14:"featuredPlants";a:10:{i:0;a:17:{s:2:"id";i:102;s:8:"tiv_name";s:5:"Ahuma";s:12:"english_name";s:6:"Cowpea";s:15:"scientific_name";s:17:"Vigna unguiculata";s:11:"description";s:173:"Cowpea is a fast-growing legume crop widely grown in Africa (especially Nigeria), Asia, and parts of the Americas. It’s valued for food, animal feed, and soil improvement.";s:14:"medicinal_uses";s:128:"Improves blood level (rich in iron)

Helps digestion due to high fiber

Useful in managing diabetes

Supports heart health";s:9:"food_uses";s:123:"Eaten as boiled beans

Used to prepare akara and moi-moi

Used in bean porridge

Leaves and husks used as animal feed";s:11:"ritual_uses";s:113:"Used in traditional ceremonies

Symbol of fertility and abundance

Used during festivals and family occasions";s:11:"cultivation";s:148:"Seeds
Grows in warm climates

Requires well-drained soil

Planted at the beginning of the rainy season

Harvested 2–3 months after planting";s:5:"image";s:34:"plant_6979320e6e8f4_1769550350.jpg";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:8;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-27 22:45:50";s:10:"updated_at";s:19:"2026-03-18 18:06:39";s:9:"source_id";N;}i:1;a:17:{s:2:"id";i:101;s:8:"tiv_name";s:5:"Vambe";s:12:"english_name";s:73:"Kapok tree, silk-cotton tree, white silk cotton tree, Java cotton, Ceiba.";s:15:"scientific_name";s:15:"Ceiba pentandra";s:11:"description";s:228:"Ceiba pentandra is a massive deciduous tree with a buttressed trunk, whorled umbrella-like branches, spiny young bark, palmately compound leaves, fragrant night-blooming flowers, and woody capsules containing silky kapok fibers.";s:14:"medicinal_uses";s:172:"Bark, leaves, roots, and sap are used in traditional medicine to treat digestive issues, fever, coughs, wounds, hypertension, respiratory problems, and as an abortifacient.";s:9:"food_uses";s:119:"Young leaves, flowers, and seeds are edible, with seeds yielding oil, and wood ash sometimes used as a salt substitute.";s:11:"ritual_uses";s:178:"The tree is sacred in Mayan culture, symbolically links the underworld and cosmos, serves as a ceremonial or meeting tree in West Africa, and provides wood for masks and carvings";s:11:"cultivation";s:200:"Kapok trees are grown from seeds or cuttings in tropical, well-drained soils, require space and light, can be intercropped, and bear fruit after 3–4 years with full fiber production in 7–10 years.";s:5:"image";s:34:"plant_697294234a261_1769116707.png";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:5;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 22:18:27";s:10:"updated_at";s:19:"2026-03-18 21:07:06";s:9:"source_id";N;}i:2;a:17:{s:2:"id";i:100;s:8:"tiv_name";s:9:"Wuheniyou";s:12:"english_name";s:23:"African sensitive plant";s:15:"scientific_name";s:21:"Biophytum petersianum";s:11:"description";s:164:"This is a small, erect annual herb with touch-sensitive rosette leaves, brightly colored flowers, and tiny capsules, commonly growing in sunny, sandy open habitats.";s:14:"medicinal_uses";s:266:"The plant is widely used in African and Southeast Asian traditional medicine for fertility enhancement, malaria and fever treatment, wounds, kidney and urinary disorders, neurological conditions, and snakebite, with proven antioxidant and anti-inflammatory activity.";s:9:"food_uses";s:132:"Though not a common food, it is sometimes used as a functional herbal tea or supplement due to its high antioxidant vitamin content.";s:11:"ritual_uses";s:152:"It plays a role in traditional fertility practices, folk healing, and local ritual or superstition-based applications in parts of Africa and West Papua.";s:11:"cultivation";s:178:"A hardy, fast-growing herb, it thrives in tropical climates on sandy soils, reproduces by seed, requires minimal care, and is often harvested from the wild or lightly cultivated.";s:5:"image";s:35:"plant_697292e0f3a58_1769116384.jpeg";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:20;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 22:13:04";s:10:"updated_at";s:19:"2026-03-18 15:24:33";s:9:"source_id";N;}i:3;a:17:{s:2:"id";i:99;s:8:"tiv_name";s:6:"Atsaka";s:12:"english_name";s:12:"Sweet Potato";s:15:"scientific_name";s:15:"Ipomoea batatas";s:11:"description";s:202:"Sweet potato (Ipomoea batatas) is a creeping perennial vine grown for its starchy, edible tuberous roots, with heart-shaped leaves, morning-glory-like flowers, and highly variable skin and flesh colors.";s:14:"medicinal_uses";s:183:"Sweet potato is valued for antioxidant, anti-diabetic, anti-inflammatory, wound-healing, and potential cancer-preventive properties due to its rich nutrient and phytochemical content.";s:9:"food_uses";s:171:"Its tubers and young leaves are widely eaten in diverse cooked forms and processed into starches and traditional dishes across Africa, Asia, the Americas, and the Pacific.";s:11:"ritual_uses";s:175:"The crop holds deep cultural importance worldwide, featuring in ancient South American civilizations, Polynesian traditions, famine prevention history, and seasonal festivals.";s:11:"cultivation";s:170:"It is propagated vegetatively in warm, frost-free climates on well-drained soils, harvested within months, and often cured after harvest to enhance storage and sweetness.";s:5:"image";s:34:"plant_69728f226d9ed_1769115426.jpg";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:4;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 21:57:06";s:10:"updated_at";s:19:"2026-03-18 21:06:50";s:9:"source_id";N;}i:4;a:17:{s:2:"id";i:98;s:8:"tiv_name";s:3:"Imo";s:12:"english_name";s:56:"Velvet bean, Cowitch, Cowhage, Monkey tamarind, Sea bean";s:15:"scientific_name";s:15:"Mucuna pruriens";s:11:"description";s:161:"Mucuna pruriens is a vigorous climbing legume with trifoliate leaves, long drooping flower clusters, itchy hair-covered pods, and oblong seeds of varying colors.";s:14:"medicinal_uses";s:195:"The plant is a key Ayurvedic medicine used for Parkinson’s disease, male fertility, nervous disorders, snakebite treatment, inflammation, and antioxidant support due to its high L-DOPA content.";s:9:"food_uses";s:151:"After thorough detoxification, the seeds and young pods are eaten as protein-rich foods or used as a coffee substitute, though raw parts are poisonous.";s:11:"ritual_uses";s:163:"Known for its irritating pods, Mucuna pruriens is used in protective charms, ritual medicine, and traditional treatments for poisoning and neurological conditions.";s:11:"cultivation";s:173:"It is cultivated by direct seeding in warm, moist climates, often intercropped as a climbing cover crop valued for nitrogen fixation, weed suppression, and soil improvement.";s:5:"image";s:34:"plant_69728e0b0c0d9_1769115147.jpg";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:1;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 21:52:27";s:10:"updated_at";s:19:"2026-03-16 23:21:59";s:9:"source_id";N;}i:5;a:17:{s:2:"id";i:97;s:8:"tiv_name";s:3:"Mou";s:12:"english_name";s:6:"Cotton";s:15:"scientific_name";s:14:"Gossypium spp.";s:11:"description";s:196:"Cotton (Gossypium spp.) consists of shrubby plants with lobed leaves, large yellow or white flowers, and bolls that release white fibers around black seeds, containing the toxic compound gossypol.";s:14:"medicinal_uses";s:205:"Traditionally, cotton parts are used for reproductive, gastrointestinal, skin, and pain-related treatments, though their use requires caution due to gossypol’s serious toxicity and contraceptive effects.";s:9:"food_uses";s:139:"Refined cottonseed oil is widely used for cooking, while properly processed seeds may be eaten, but unrefined seeds and products are toxic.";s:11:"ritual_uses";s:115:"Cotton flowers and plant parts are used in traditional dye-making and spiritual healing practices in some cultures.";s:11:"cultivation";s:144:"Cotton is grown from seed in warm climates on well-drained fertile soils and harvested by collecting mature bolls for fiber and seed processing.";s:5:"image";s:34:"plant_69728ae4bbb7d_1769114340.jpg";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:1;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 21:39:00";s:10:"updated_at";s:19:"2026-03-16 23:17:29";s:9:"source_id";N;}i:6;a:17:{s:2:"id";i:96;s:8:"tiv_name";s:11:"Mgbelayongo";s:12:"english_name";s:70:"Spreading Hogweed, Red Spiderling, Tarvine, Wineflower, Horse Purslane";s:15:"scientific_name";s:17:"Boerhavia diffusa";s:11:"description";s:154:"Punarnava is a creeping perennial herb with purplish, hairy stems, unequal opposite leaves, small pink-violet flowers, sticky fruits, and fleshy taproots.";s:14:"medicinal_uses";s:180:"It is a renowned Ayurvedic rejuvenative and diuretic used for kidney and liver disorders, inflammation, pain, respiratory and digestive issues, skin diseases, and general vitality.";s:9:"food_uses";s:152:"Young leaves and shoots are eaten as a nutritious leafy vegetable, while the roots are occasionally consumed, providing minerals and essential vitamins.";s:11:"ritual_uses";s:173:"Though not central to formal rituals, Punarnava is regarded as a sacred healing herb symbolizing renewal and is sometimes used in health-restorative and cleansing practices.";s:11:"cultivation";s:181:"The plant grows easily from seed in sunny, well-drained soils with minimal care and can be cultivated in fields or containers, with leaves harvested regularly and roots at maturity.";s:5:"image";s:34:"plant_6972899195e12_1769114001.jpg";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 21:33:21";s:10:"updated_at";s:19:"2026-01-22 21:33:21";s:9:"source_id";N;}i:7;a:17:{s:2:"id";i:95;s:8:"tiv_name";s:6:"Malina";s:12:"english_name";s:46:"Gmelina, White Teak, Goomar Teak, Kashmir Tree";s:15:"scientific_name";s:15:"Gmelina arborea";s:11:"description";s:168:"Gmelina arborea is a tall deciduous tree with a straight trunk, shedding pale bark, large heart-shaped leaves, fragrant yellow flowers, and edible yellow-orange drupes.";s:14:"medicinal_uses";s:200:"All parts of the tree are used in traditional medicine as tonics, laxatives, anti-inflammatory agents, wound treatments, and remedies for fever, digestive disorders, skin diseases, and blood ailments.";s:9:"food_uses";s:135:"Its ripe fruits are eaten, flowers are cooked with rice in traditional dishes, and the leaves serve as nutritious fodder for livestock.";s:11:"ritual_uses";s:139:"The tree holds cultural and sacred value, with its wood used for traditional musical instruments and its flowers featured in festive foods.";s:11:"cultivation";s:195:"Gmelina arborea is a fast-growing, seed-propagated tree suited to warm, humid climates and fertile soils, widely planted for timber, shade, and plantation use due to its strong coppicing ability.";s:5:"image";s:34:"plant_697287802241d_1769113472.png";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:1;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 21:24:32";s:10:"updated_at";s:19:"2026-03-18 21:03:22";s:9:"source_id";N;}i:8;a:17:{s:2:"id";i:94;s:8:"tiv_name";s:4:"Alum";s:12:"english_name";s:12:"Sweet Orange";s:15:"scientific_name";s:15:"Citrus sinensis";s:11:"description";s:175:"The orange tree is an evergreen, spiny, small-to-medium tree with aromatic glossy leaves, fragrant white flowers, and sweet, segmented orange fruits, native to Southeast Asia.";s:14:"medicinal_uses";s:215:"Oranges support immunity, heart health, digestion, respiratory wellness, skin care, anxiety reduction, cancer prevention, and kidney-stone control due to their vitamins, flavonoids, antioxidants, and essential oils.";s:9:"food_uses";s:148:"The fruit is widely eaten fresh, processed into juice, and used in cooking, baking, marmalades, and flavoring through zest and orange blossom water.";s:11:"ritual_uses";s:152:"Oranges and orange blossoms symbolize prosperity, purity, and abundance and are commonly used in weddings, cultural traditions, and spiritual offerings.";s:11:"cultivation";s:192:"Orange trees are propagated by grafting and grown in sunny, warm climates on well-drained soils, with fruits harvested only when fully ripe and protected from common citrus pests and diseases.";s:5:"image";s:34:"plant_69728693b9bf6_1769113235.png";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 21:20:35";s:10:"updated_at";s:19:"2026-01-22 21:20:35";s:9:"source_id";N;}i:9;a:17:{s:2:"id";i:93;s:8:"tiv_name";s:6:"Tampue";s:12:"english_name";s:42:"Cutleaf groundcherry, wild cape gooseberry";s:15:"scientific_name";s:17:"Physalis angulata";s:11:"description";s:181:"Physalis angulata is an erect annual herb with lantern-like calyx-enclosed berries, ovate leaves, and pale yellow flowers, whose ripe fruits are edible while unripe parts are toxic.";s:14:"medicinal_uses";s:227:"The plant is widely used in traditional medicine as an anti-inflammatory, immune stimulant, and antimicrobial for treating pain, respiratory illnesses, liver disorders, metabolic diseases, infections, and postpartum conditions.";s:9:"food_uses";s:132:"Its ripe berries are eaten fresh or processed into sauces, jams, and salads, while young leaves are sometimes cooked as a vegetable.";s:11:"ritual_uses";s:183:"Physalis angulata is culturally used in traditional healing practices, children’s play, and ritual poultices for skin ailments and snake bites in parts of Africa and Southeast Asia.";s:11:"cultivation";s:159:"Easily grown from seed in warm, well-drained soils, it is a fast-growing plant harvested when the papery husk dries, though it can host crop-damaging diseases.";s:5:"image";s:35:"plant_697284d6cae3c_1769112790.jpeg";s:10:"audio_file";N;s:11:"is_featured";i:1;s:10:"view_count";i:4;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-22 21:13:10";s:10:"updated_at";s:19:"2026-03-19 10:46:25";s:9:"source_id";N;}}s:17:"featuredFestivals";a:8:{i:0;a:18:{s:2:"id";i:3;s:8:"tiv_name";s:14:"Kyegh Sha Shwa";s:12:"english_name";s:32:"Kyegh Sha Shwa Cultural Festival";s:13:"festival_type";s:26:"Food and Cultural Festival";s:11:"description";s:288:"An annual large-scale Tiv cultural gathering held in Makurdi. It celebrates Tiv heritage through traditional food, music, and dance. The festival is especially associated with Nyamkyegh sha shwa, a traditional chicken and beniseed dish that holds deep cultural meaning for the Tiv people.";s:12:"significance";s:326:"This festival serves as a living expression of Tiv culinary heritage and communal identity. It brings together Tiv people across generations to share, perform, and transmit their food traditions, dances, and music. The Nyamkyegh sha shwa dish is central to the gathering, symbolising Tiv domesticity and agricultural heritage.";s:6:"timing";s:8:"December";s:8:"duration";N;s:10:"activities";s:134:"Traditional Tiv food preparation and sharing, cultural dances, music performances, community gathering, display of traditional attire.";s:8:"location";s:20:"Makurdi, Benue State";s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:2;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 14:17:03";s:9:"source_id";N;s:13:"gallery_image";N;}i:1;a:18:{s:2:"id";i:4;s:8:"tiv_name";s:9:"Kwagh-Hir";s:12:"english_name";s:25:"Kwagh-Hir Puppet Festival";s:13:"festival_type";s:31:"Dramatic / Performance Festival";s:11:"description";s:330:"A renowned Tiv dramatic folk theatre tradition that uses puppets, marionettes, masquerades, music, and storytelling. It presents themes of social conflict, history, morality, and community ethics through highly creative performance. Kwagh-Hir is regarded as one of Africa's most sophisticated indigenous puppet theatre traditions.";s:12:"significance";s:314:"Kwagh-Hir is not merely entertainment — it is a powerful instrument of social commentary and moral education among the Tiv. Through symbolic puppetry and drama, communities critique injustice, retell history, and affirm shared values. It is a form of living cultural philosophy performed for the whole community.";s:6:"timing";s:18:"December – April";s:8:"duration";N;s:10:"activities";s:138:"Puppetry performances, marionette displays, masquerades, storytelling, live music, dramatic re-enactments of social and historical themes.";s:8:"location";s:42:"Tiv communities, especially in Benue State";s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:2;a:18:{s:2:"id";i:5;s:8:"tiv_name";s:7:"Tiv Day";s:12:"english_name";s:19:"Tiv Day Celebration";s:13:"festival_type";s:36:"Cultural Unity and Identity Festival";s:11:"description";s:320:"A major annual celebration that brings Tiv people together across Nigeria and the diaspora to celebrate their shared identity, culture, and heritage. It commonly features traditional attire, dance, storytelling, and cultural discussions. Tiv Day is a unifying moment of pride and cultural affirmation for the Tiv nation.";s:12:"significance";s:275:"Tiv Day represents a conscious effort by the Tiv people to preserve and celebrate their cultural identity in the face of modernisation. It reaffirms the values of the A'nger fabric, the Swange dance, and communal storytelling as living symbols of Tiv resilience and cohesion.";s:6:"timing";s:6:"Annual";s:8:"duration";N;s:10:"activities";s:159:"A'nger traditional attire display, Swange dance performances, storytelling sessions, cultural lectures and panel discussions, community reunion and networking.";s:8:"location";s:38:"Gboko and major cities including Lagos";s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:3;a:18:{s:2:"id";i:6;s:8:"tiv_name";s:4:"Ivom";s:12:"english_name";s:19:"Ivom Dance Festival";s:13:"festival_type";s:35:"Dance and Cultural Renewal Festival";s:11:"description";s:290:"A traditional Tiv festival centred on the Ivom dance. It promotes cultural renewal, celebration, and the preservation of Tiv dance aesthetics and performance traditions. The Ivom festival is a gathering of communities around the shared love of Tiv movement, rhythm, and artistic expression.";s:12:"significance";s:230:"The Ivom Dance Festival is a vehicle for passing down traditional Tiv dance forms to younger generations. It reinforces the cultural importance of rhythm, communal performance, and artistic identity as foundations of Tiv heritage.";s:6:"timing";s:50:"Not specifically fixed; held as communities decide";s:8:"duration";N;s:10:"activities";s:131:"Ivom dance performances, cultural exhibitions, musical accompaniment, celebration of dance heritage, renewal of communal tradition.";s:8:"location";s:15:"Tiv communities";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:4;a:18:{s:2:"id";i:7;s:8:"tiv_name";s:5:"Akata";s:12:"english_name";s:22:"Akata Fishing Festival";s:13:"festival_type";s:29:"Fishing and Communal Festival";s:11:"description";s:363:"A traditional fishing festival held in Katsina-Ala that showcases local fishing skills and techniques. It attracts participants and competitors from Tiv, Etulo, and Jukun communities, making it one of the most inter-ethnic cultural events along the Katsina-Ala River. It celebrates the riverine heritage and livelihood of the communities that depend on the river.";s:12:"significance";s:298:"The Akata Fishing Festival affirms the deep relationship between the Tiv and neighbouring communities and the rivers that sustain them. It celebrates indigenous ecological knowledge, inter-community cooperation, and the cultural significance of fishing as a way of life along the Katsina-Ala River.";s:6:"timing";s:13:"March – May";s:8:"duration";N;s:10:"activities";s:214:"Fishing competitions using traditional methods, demonstration of indigenous fishing techniques, inter-community participation from Tiv, Etulo and Jukun, cultural performances and celebration of riverine livelihood.";s:8:"location";s:11:"Katsina-Ala";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:5;a:18:{s:2:"id";i:8;s:8:"tiv_name";s:19:"Biem and Toho Yilan";s:12:"english_name";s:36:"Biem and Toho Yilan Hunting Festival";s:13:"festival_type";s:16:"Hunting Festival";s:11:"description";s:328:"A traditional Tiv hunting festival involving both inter-clan hunting expeditions (Biem) and intra-clan hunting expeditions (Toho Yilan). These expeditions are usually accompanied by cultural dances and communal celebration. The festival reflects the historical importance of hunting in Tiv social organisation and clan identity.";s:12:"significance";s:274:"The Biem and Toho Yilan festival reinforces Tiv clan solidarity and the tradition of collective endeavour. Hunting is not merely a subsistence activity but a ritual that binds clans together, tests endurance, and reaffirms the covenant between the Tiv people and their land.";s:6:"timing";s:18:"December – April";s:8:"duration";N;s:10:"activities";s:154:"Inter-clan hunting expeditions (Biem), intra-clan hunting expeditions (Toho Yilan), cultural dances following the hunt, communal feasting and celebration.";s:8:"location";s:15:"Tiv communities";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:6;a:18:{s:2:"id";i:9;s:8:"tiv_name";s:6:"Nyinya";s:12:"english_name";s:15:"Nyinya Festival";s:13:"festival_type";s:34:"Wealth / Social Status Celebration";s:11:"description";s:330:"A traditional celebration of affluence in which a person who acquires a horse — a powerful symbol of wealth and prestige among the Tiv — hosts a feast for their age group. The event is marked by praise songs, feasting, and traditional dance performances. The horse (nyinya) is one of the highest status symbols in Tiv culture.";s:12:"significance";s:317:"The Nyinya Festival reflects the Tiv value system in which personal achievement is celebrated communally. Wealth is not hoarded but shared with one's age group, reinforcing bonds of solidarity and reciprocity. The horse as a status symbol also connects to Tiv concepts of strength, war readiness, and spiritual power.";s:6:"timing";s:53:"Not specifically fixed; held when a horse is acquired";s:8:"duration";N;s:10:"activities";s:166:"Communal feast hosted by the horse owner, praise songs (ikyagh) performed by traditional singers, traditional dance performances, age-group gathering and celebration.";s:8:"location";s:15:"Tiv communities";s:5:"image";N;s:11:"is_featured";i:0;s:10:"view_count";i:0;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-03-20 13:49:42";s:10:"updated_at";s:19:"2026-03-20 13:49:42";s:9:"source_id";N;s:13:"gallery_image";N;}i:7;a:18:{s:2:"id";i:2;s:8:"tiv_name";s:22:"Iniongo i iyou mbi her";s:12:"english_name";s:16:"New Yam Festival";s:13:"festival_type";N;s:11:"description";s:71:"Annual harvest celebration marking the beginning of the new yam season.";s:12:"significance";s:73:"Thanksgiving for successful harvest and prayers for continued prosperity.";s:6:"timing";s:38:"August/September after the yam harvest";s:8:"duration";N;s:10:"activities";s:65:"Traditional dances, feasting, offering of first yams to ancestors";s:8:"location";N;s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:3;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-16 19:13:12";s:10:"updated_at";s:19:"2026-03-19 16:12:56";s:9:"source_id";N;s:13:"gallery_image";N;}}s:13:"featuredFoods";a:2:{i:0;a:15:{s:2:"id";i:1;s:8:"tiv_name";s:10:"Ruam Kumen";s:12:"english_name";s:11:"Pounded Yam";s:11:"description";s:75:"A staple food made from boiled and pounded yams, served with various soups.";s:11:"ingredients";s:17:"Fresh yams, water";s:18:"preparation_method";s:87:"Yams are peeled, boiled until soft, then pounded in a mortar until smooth and stretchy.";s:19:"serving_suggestions";N;s:21:"cultural_significance";N;s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:4;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-16 19:13:12";s:10:"updated_at";s:19:"2026-03-19 15:02:32";s:9:"source_id";N;}i:1;a:15:{s:2:"id";i:2;s:8:"tiv_name";s:6:"Gbande";s:12:"english_name";s:8:"Tiv Soup";s:11:"description";s:61:"A traditional Tiv soup made with local vegetables and spices.";s:11:"ingredients";s:63:"Bitter leaf, locust beans, palm oil, meat or fish, local spices";s:18:"preparation_method";s:84:"Vegetables are washed and cooked with meat stock, palm oil and seasonings are added.";s:19:"serving_suggestions";N;s:21:"cultural_significance";N;s:5:"image";N;s:11:"is_featured";i:1;s:10:"view_count";i:3;s:10:"created_by";i:1;s:10:"created_at";s:19:"2026-01-16 19:13:12";s:10:"updated_at";s:19:"2026-03-20 14:05:55";s:9:"source_id";N;}}s:15:"featuredAnimals";a:10:{i:0;a:14:{s:2:"id";i:11;s:8:"tiv_name";s:5:"Anyam";s:4:"name";s:7:"Leopard";s:11:"description";s:99:"Wild predator; one of the most spiritually significant animals in Tiv culture. Also known as Anyam.";s:12:"cultural_use";s:96:"Used in Igbe religious rites for anti-witchcraft protection; priests invoke the leopard's power.";s:16:"symbolic_meaning";s:96:"Power, ancestral aggression, spiritual authority, and anti-witchcraft force; used in Igbe rites.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";s:19:"2026-03-20 13:15:53";s:10:"updated_at";s:19:"2026-03-20 13:15:53";}i:1;a:14:{s:2:"id";i:12;s:8:"tiv_name";s:4:"Bagu";s:4:"name";s:6:"Monkey";s:11:"description";s:87:"Wild primate associated with mystical transformation in Tiv belief. Also known as Bagu.";s:12:"cultural_use";s:68:"Used in rituals of spiritual embodiment and mystical transformation.";s:16:"symbolic_meaning";s:85:"Linked to mystical transformation, spiritual embodiment, and external soul symbolism.";s:6:"source";s:167:"Waapela, N.P. (2013). Animal Symbols as Gateway to the Divine in Tiv Religion. Department of Religion and Philosophy, Faculty of Arts, Benue State University, Makurdi.";s:5:"image";N;s:11:"animal_type";s:4:"wild";s:9:"source_id";N;s:10:"created_by";i:1;s:5:"views";i:0;s:10:"created_at";